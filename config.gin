main.cuda_visible_devices = "1,3"
main.hug_token = "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"    # Enter your Huggingface-Token here
main.model_dir = "savings"                                  # Relative filepath for savings of tuning and evaluation
main.adapter_dir = "savings/Qwen2.5-Coder-7B-Instruct_2026-03-17_09-39-52"
main.model_name = "Qwen/Qwen2.5-Coder-7B-Instruct"              # Copy model name from huggingface
