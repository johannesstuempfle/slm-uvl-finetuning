main.finetuning = True                                      # Change to false for evaluating model without fine-tuning

get_dataset.train_eval_split = 0.9                          # Split for train/eval data

get_unsupervised_datasets.seq_length = 1024                 # Sequence length for unsupervised tuning (also limits file size -> one file one seqiuence)
get_unsupervised_datasets.git_urls = ["https://github.com/Universal-Variability-Language/uvl-models.git"]
get_unsupervised_datasets.repo_dir = "uvl-repos"            # Relative folderpath with uvl files

get_supervised_datasets.file = "uvl-repos/uvl_dataset.json" #
get_supervised_datasets.system_prompt = "Translate the following text with variabilities to syntactic correct uvl-Code: "


train.epochs = 10                                           # Trainign Epochs
train.batch_size = 1                                        # Batch size
train.lr = 5e-5                                             # Learning rate
train.lr_sheduler = "constant"                              # Learning rate sheduler
train.lora_params = {"rank": 8, "dropout": 0.1, "alpha": 16}# Lora params

evaluate.dataset_file = "uvl-repos/test_dataset.json"       # Test dataset for score evaluation