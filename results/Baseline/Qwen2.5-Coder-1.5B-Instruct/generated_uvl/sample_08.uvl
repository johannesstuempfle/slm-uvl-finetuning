module UniversityCourseRegistrationSystem;

    // Define constants
    constant MIN_CREDITS = 12;
    constant MAX_ROBOTICS_LAB_STUDENTS = 20;

    // Define enumerations
    enumeration CourseType {
        UNDERGRADUATE,
        GRADUATE
    }

    enumeration EnrollmentStatus {
        REGISTERED,
        NOT_REGISTERED
    }

    // Define structures
    struct Student {
        string name;
        CourseType courseType;
        integer creditCount;
        list<Course> registeredCourses;
    }

    struct Course {
        string name;
        integer creditCount;
        boolean hasPrerequisites;
        list<Course> prerequisiteCourses;
        boolean isMutuallyExclusive;
        EnrollmentStatus status;
    }

    // Define functions
    function void registerStudent(Student& student, Course& course);
    function void unregisterStudent(Student& student, Course& course);
    function bool canRegisterStudent(Student& student, Course& course);
    function void setEnrollmentStatus(Student& student, Course& course, EnrollmentStatus status);

    // Define variables
    var students: list<Student>;
    var courses: list<Course>;

    // Initialize data
    initializeData();

    // Main program
    main() {
        // Example usage
        Student student1 = {"Alice", UNDERGRADUATE, 0, []};
        Course advancedAI = {"Advanced AI", 4, true, [introToAI, linearAlgebra], false, ENROLLED};
        registerStudent(student1, advancedAI);
        print("Student " + student1.name + " registered in " + advancedAI.name);
    }

endmodule

// Define helper functions
function void initializeData() {
    // Add some sample data
    students = [];
    courses = [];

    introToAI = {"Introduction to AI", 3, false, [], false, NOT_REGISTERED};
    linearAlgebra = {"Linear Algebra", 4, false, [], false, NOT_REGISTERED};

    statisticsForBiology = {"Statistics for Biology", 3, true, [statisticsForBusiness], false, NOT_REGISTERED};
    statisticsForBusiness = {"Statistics for Business", 3, true, [statisticsForBiology], false, NOT_REGISTERED};

