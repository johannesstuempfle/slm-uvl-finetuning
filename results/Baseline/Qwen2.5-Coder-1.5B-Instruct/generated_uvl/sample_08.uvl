}

function void registerStudent(Student& student, Course& course) {
    if (!canRegisterStudent(student, course)) {
        return;
    }
    student.registeredCourses.append(course);
    setEnrollmentStatus(student, course, ENROLLED);
}

function void unregisterStudent(Student& student, Course& course) {
    if (!isRegisteredInCourse(student, course)) {
        return;
    }
    student.registeredCourses.remove(course);
    setEnrollmentStatus(student, course, NOT_REGISTERED);
}

function bool canRegisterStudent(Student& student, Course& course) {
    if (student.creditCount < MIN_CREDITS) {
        return false;
    }
    if ((course.courseType == UNDERGRADUATE &&!hasSelectedCoreCourse(student, course)) || 
        (course.courseType == GRADUATE &&!hasSelectedSeminar(course))) {
        return false;
    }
    if (course.hasPrerequisites &&!areAllPrerequisitesMet(student, course)) {
        return false;
    }
    if (course.isMutuallyExclusive && isRegisteredInOtherCourse(student, course)) {
        return false;
    }
    return true;
}

function bool isRegisteredInCourse(Student& student, Course& course) {
    return student.registeredCourses.contains(course);
}

