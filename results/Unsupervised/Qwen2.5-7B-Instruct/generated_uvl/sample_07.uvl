```uvl
features
    RoomBookingService
        mandatory
            Room
                mandatory
                    BasicFeatures
                        alternative
                            NumberOfBeds {abstract}
                                alternative
                                    SingleBed
                                    DoubleBed
                                    TwoBeds
                                    FourBeds
                            View {abstract}
                                alternative
                                    CityView
